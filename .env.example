# Copy this file to .env and fill in your own values. Never commit .env.
SOCRATA_APP_TOKEN=your_socrata_app_token   # free: https://data.cambridgema.gov/profile/edit/developer_settings

# Pipeline database (docker-compose maps it to localhost:5433)
POSTGRES_USER=cpd_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cpd_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# pgAdmin login (http://localhost:8081)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# Metabase's own application database
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change_me
